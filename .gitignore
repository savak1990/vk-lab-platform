# OS
.DS_Store

# Terraform
**/.terraform/
**/.terragrunt-cache/
**/.terragrunt-stack/
*.tfstate
*.tfstate.*
crash*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform variable files may hold secret values; ignore by default.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Helm
**/charts/*.tgz

# Secrets: only the personal lab's own per-value encrypted ciphertext files
# (one file per value, never combined - constitution §5/§14) and one-way
# bcrypt hashes (safe to commit as plain text, see secrets/README.md), under
# secrets/vk-lab-platform/, plus this directory's own docs, are tracked.
# Every other secrets/<project>/ directory - throwaway CI/test projects,
# make generate-secrets output - is fully untracked, *.enc included; it's
# meant to be regenerated, not committed.
secrets/*
!secrets/vk-lab-platform/
secrets/vk-lab-platform/*
!secrets/vk-lab-platform/*.enc
!secrets/vk-lab-platform/*.bcrypt
!secrets/README.md

# Editors
.vscode/
.idea/

# Local Claude Code permissions (machine-specific)
.claude/settings.local.json
