# OS
.DS_Store

# Terraform
**/.terraform/
**/.terragrunt-cache/
**/.terragrunt-stack/
*.tfstate
*.tfstate.*
crash*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform variable files may hold secret values; ignore by default.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Helm
**/charts/*.tgz

# Secrets: only the encrypted bootstrap ciphertext is tracked.
secrets/*
!secrets/lab-secrets.enc

# Editors
.vscode/
.idea/

# Local Claude Code permissions (machine-specific)
.claude/settings.local.json
