# OS
.DS_Store

# Terraform
**/.terraform/
**/.terragrunt-cache/
**/.terragrunt-stack/
*.tfstate
*.tfstate.*
crash*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform variable files may hold secret values; ignore by default.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Helm
**/charts/*.tgz

# Secrets: only per-value encrypted ciphertext files (one file per value,
# never combined - constitution §5/§14), nested under secrets/<project>/,
# and this directory's own docs are tracked. Any plaintext dropped here
# locally must never be committed.
secrets/*
!secrets/*/
secrets/*/*
!secrets/**/*.enc
!secrets/README.md

# Editors
.vscode/
.idea/

# Local Claude Code permissions (machine-specific)
.claude/settings.local.json
