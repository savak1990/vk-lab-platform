# OS
.DS_Store

# Terraform
**/.terraform/
**/.terragrunt-cache/
**/.terragrunt-stack/
*.tfstate
*.tfstate.*
crash*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform variable files may hold secret values; ignore by default.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Helm
**/charts/*.tgz

# Secrets: per-value encrypted ciphertext files (one file per value, never
# combined - constitution §5/§14) and one-way bcrypt hashes are tracked for
# every secrets/<project>/, not just the default lab's, because a project name
# is now free-form and a durable second lab must survive a fresh clone.
# A throwaway CI project committing three regenerable ciphertext files is the
# cheaper failure. Plaintext under these directories stays ignored.
secrets/*
!secrets/*/
secrets/*/*
!secrets/*/*.enc
!secrets/*/*.bcrypt
!secrets/*/civo-ca-cert*.pem
!secrets/root-domain.enc
!secrets/civo-token.enc
!secrets/README.md

# Raw key material — ignore even under secrets/ directories
*.key
*-key.pem

# Editors
.vscode/
.idea/

# Claude Code local state: permissions, worktrees, session data - all machine-specific.
# The directory contents are ignored rather than the directory itself: git cannot
# re-include a file whose parent directory is excluded, and settings.json must be
# tracked so the destructive-action policy reaches a cloud session's checkout and
# every fresh clone, neither of which sees a machine-local settings file.
.claude/*
!.claude/settings.json

# Subagent-driven-development scratch (ledger, briefs, review packages).
.superpowers/
